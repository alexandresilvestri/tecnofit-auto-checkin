{
  "name": "tecnofit-auto-checkin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/functions/*",
    "apps/web"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "node scripts/build-functions.mjs",
    "moto:up": "docker compose -f tests/docker-compose.yml up -d",
    "connect": "tsx scripts/connect.ts",
    "schedule": "tsx scripts/schedule.ts",
    "invite": "tsx scripts/invite.ts",
    "migrate": "tsx scripts/migrate.ts",
    "web:dev": "npm -w apps/web run dev",
    "web:build": "npm -w apps/web run build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "3.1154.0",
    "@aws-sdk/client-dynamodb": "3.1154.0",
    "@aws-sdk/client-sts": "3.1154.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.5",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "msw": "3.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
